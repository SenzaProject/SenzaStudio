    <string name="dm_pending_note">Beban CPU, data GPU, dan sensor suhu belum dibuat. Semuanya direncanakan di fase 4 dan hanya akan tampil bila Android menyediakan data nyata.</string>

    <string name="perm_intro">Game Master hanya meminta akses untuk fitur yang membutuhkannya. Semua izin bersifat opsional dan bisa diubah nanti di Pengaturan.</string>
    <string name="perm_usage_title">Akses penggunaan</string>
    <string name="perm_usage_why">Memungkinkan Game Master mengetahui game mana yang sedang di depan, untuk mencatat sesi bermain dan menerapkan pengaturan per game.</string>
    <string name="perm_overlay_title">Tampil di atas aplikasi lain</string>
    <string name="perm_overlay_why">Dibutuhkan untuk panel game melayang dan overlay FPS saat game berjalan.</string>
    <string name="perm_notif_title">Notifikasi</string>
    <string name="perm_notif_why">Android mewajibkan notifikasi yang terlihat untuk layanan yang menjaga overlay dan pemantauan tetap berjalan.</string>
    <string name="perm_dnd_title">Akses Jangan Ganggu</string>
    <string name="perm_dnd_why">Memungkinkan Game Master membungkam gangguan saat kamu bermain lalu mengembalikan pengaturan sebelumnya.</string>
