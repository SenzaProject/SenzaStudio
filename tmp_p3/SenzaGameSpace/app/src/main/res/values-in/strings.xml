    <string name="onboarding_1_title">Selamat datang di Game Master</string>
    <string name="onboarding_1_body">Satu tempat untuk membuka game, memantau kondisi HP, dan mengatur tiap game sesuai kebiasaanmu.</string>
    <string name="onboarding_2_title">Hanya data nyata</string>
    <string name="onboarding_2_body">Semua angka berasal dari Android sendiri. Kalau suatu data tidak tersedia di HP-mu, Game Master akan bilang begitu, bukan menebak.</string>
    <string name="onboarding_3_title">Kamu yang memilih izin</string>
    <string name="onboarding_3_body">Beberapa fitur butuh akses khusus, misalnya tampil di atas aplikasi lain. Berikutnya kamu bisa meninjau satu per satu dan memberi hanya yang kamu mau.</string>
    <string name="onboarding_next">Berikutnya</string>
