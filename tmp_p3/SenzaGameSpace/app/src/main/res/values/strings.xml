    <string name="splash_tagline">Your gaming assistant</string>

    <string name="onboarding_1_title">Welcome to Game Master</string>
    <string name="onboarding_1_body">One place to launch your games, watch how your phone is doing, and set up each game the way you like.</string>
    <string name="onboarding_2_title">Real data only</string>
    <string name="onboarding_2_body">Every number comes from Android itself. When a reading is not available on your phone, Game Master says so instead of guessing.</string>
    <string name="onboarding_3_title">You choose the permissions</string>
    <string name="onboarding_3_body">Some features need special access, such as drawing over other apps. Next you can review each one and grant only what you want.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_start">Review permissions</string>

