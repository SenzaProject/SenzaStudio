    <string name="planned_status_body">This screen only exists as a navigation target. Nothing on it is simulated. It will be built in phase %1$d.</string>
    <string name="planned_scope_title">Planned scope</string>

    <string name="desc_game_mode">Balanced, Performance, Battery saver and Custom modes with settings that are applied when a game starts and restored when it ends.</string>
    <string name="desc_fps_monitor">Frame rate and frame-time history with average, minimum and maximum, using only methods Android supports. Methods that need root will be labelled.</string>
    <string name="desc_toolbox">Do Not Disturb, brightness and volume controls, screenshot and screen recording shortcuts, gaming timer and session statistics.</string>
    <string name="desc_floating_panel">A draggable overlay with live readings and quick actions while a game is running. It needs the Display over other apps permission.</string>
    <string name="desc_network">Connection type, Wi-Fi details, signal, latency and ping tests, and speed history. Measured latency is not the same as in-game ping, and the app will say so.</string>
    <string name="desc_statistics">Total playtime, sessions, most played games and daily, weekly and monthly activity, stored on this device.</string>

