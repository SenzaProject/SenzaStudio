    <string name="about_version">Version %1$s</string>
    <string name="about_developer">Developer: SenzaProject</string>
    <string name="about_package">Package: %1$s</string>
    <string name="about_description">A gaming assistant that shows real device readings and sets up each game your way.</string>
    <string name="about_limits_title">Known limitations</string>
    <string name="about_limits_body">This is an early build. Game library and per-game profiles are in; game modes, FPS monitor, overlay, network tools and statistics are not built yet. Profiles are saved but not applied to games yet. Android does not let ordinary apps change CPU or GPU frequency, so Game Master will never claim to.</string>

