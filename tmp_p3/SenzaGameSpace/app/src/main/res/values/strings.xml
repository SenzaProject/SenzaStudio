    <string name="perm_intro">Game Master asks for access only for features that need it. Every permission is optional, and you can change them later in Settings.</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_why">Lets Game Master tell which game is in the foreground, so it can track play sessions and apply per-game settings.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_why">Needed for the floating game panel and the FPS overlay while a game is running.</string>
    <string name="perm_notif_title">Notifications</string>
    <string name="perm_notif_why">Android requires a visible notification for the service that keeps the overlay and monitoring running.</string>
    <string name="perm_dnd_title">Do Not Disturb access</string>
    <string name="perm_dnd_why">Lets Game Master silence interruptions while you play and restore your previous setting afterwards.</string>
